// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
/*
 * C8-571 / HC-WT6958 (HCMT7621-S256) board device tree
 *
 * Rebuilt from vendor firmware C8-571_2.2.7.0.bin (SquashFS + uImage, MT7621).
 * Every GPIO, partition and MAC offset below was verified against the DTB
 * extracted from that firmware; guesses from the earlier draft are marked
 * with "TODO(verify)" instead of being silently kept.
 */

/dts-v1/;

#include "mt7621.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	compatible = "c8,571", "mediatek,mt7621-soc";
	model = "C8 571";

	aliases {
		led-boot = &led_sys;
		led-failsafe = &led_sys;
		led-running = &led_sys;
		led-upgrade = &led_sys;
		label-mac-device = &gmac0;
		serial0 = &uartlite;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		bootargs = "console=ttyS0,115200n8";
	};

	leds {
		compatible = "gpio-leds";

		led_sys: sys {
			label = "blue:status";
			gpios = <&gpio 6 GPIO_ACTIVE_LOW>;
		};

		cmode5 {
			label = "blue:cmode5";
			gpios = <&gpio 7 GPIO_ACTIVE_LOW>;
		};

		wifi {
			label = "blue:wifi";
			gpios = <&gpio 14 GPIO_ACTIVE_LOW>;
		};

		cmode4 {
			label = "blue:cmode4";
			gpios = <&gpio 15 GPIO_ACTIVE_LOW>;
		};
	};

	keys {
		compatible = "gpio-keys-polled";
		poll-interval = <20>;

		reset {
			label = "reset";
			gpios = <&gpio 18 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		wps {
			label = "wps";
			gpios = <&gpio 16 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};
	};

	gpio-export {
		compatible = "gpio-export";
		#size-cells = <0>;

		cpe-power {
			gpio-export,name = "cpe-pwr";
			gpio-export,output = <0>;
			gpios = <&gpio 10 GPIO_ACTIVE_LOW>;
		};

		/*
		 * Vendor DTB drives GPIO3 here (active-high) while the same pin is
		 * also the i2c-gpio SCL line below. Only one of the two can be
		 * active; this draft keeps the I2C bus so the PT7C4338 RTC works
		 * and leaves this node disabled. Flip the two "status" properties
		 * if the CPE select line matters more than the RTC on your unit.
		 */
		cpe-select {
			status = "disabled";
			gpio-export,name = "cpe-sel0";
			gpio-export,output = <1>;
			gpios = <&gpio 3 GPIO_ACTIVE_HIGH>;
		};
	};

	/*
	 * GPIO3 = SCL, GPIO4 = SDA, PT7C4338 RTC at 0x68.
	 * Verified present in the vendor DTB (i2c-gpio / pt7c4338 nodes).
	 */
	i2c-gpio {
		compatible = "i2c-gpio";
		sda-gpios = <&gpio 4 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpio 3 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <10>;
		#address-cells = <1>;
		#size-cells = <0>;

		rtc@68 {
			compatible = "pericom,pt7c4338";
			reg = <0x68>;
		};
	};
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <10000000>;
		m25p,chunked-io = <32>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x0 0x30000>;
				read-only;
			};

			/* labelled "kpanic" in the vendor DTB, not "u-boot-env" */
			partition@30000 {
				label = "kpanic";
				reg = <0x30000 0x10000>;
				read-only;
			};

			factory: partition@40000 {
				label = "factory";
				reg = <0x40000 0x10000>;
				read-only;
			};

			/* 0xf90000 to match the vendor DTB; see README for the trade-off */
			partition@50000 {
				compatible = "denx,uimage";
				label = "firmware";
				reg = <0x50000 0xf90000>;
			};

			partition@fe0000 {
				label = "bdinfo";
				reg = <0xfe0000 0x10000>;
				read-only;
			};

			partition@ff0000 {
				label = "reserve";
				reg = <0xff0000 0x10000>;
				read-only;
			};
		};
	};
};

&pcie {
	status = "okay";
};

&pcie1 {
	wifi@0,0 {
		compatible = "mediatek,mt76";
		reg = <0x0000 0 0 0 0>;
		mediatek,mtd-eeprom = <&factory 0x0000>;
	};
};

&gmac0 {
	/*
	 * Vendor DTB takes the MAC from bdinfo@0x9. The draft used factory@0xe000;
	 * that offset is a guess, so verify it on your unit before flashing:
	 *   hexdump -C -s 0x4e000 -n 16 /dev/mtd2
	 * If factory@0xe000 does hold the MAC, this works as-is; otherwise switch
	 * to nvmem-cells = <&macaddr_factory_e000> or point it at bdinfo.
	 */
	mtd-mac-address = <&factory 0xe000>;
};

&switch0 {
	ports {
		port@0 {
			status = "okay";
			label = "lan1";
		};

		port@1 {
			status = "okay";
			label = "lan2";
		};

		port@2 {
			status = "okay";
			label = "lan3";
		};

		port@3 {
			status = "okay";
			label = "lan4";
		};

		port@4 {
			status = "okay";
			label = "wan";
			mtd-mac-address = <&factory 0xe006>;
		};
	};
};

&state_default {
	gpio {
		groups = "i2c", "jtag", "uart2", "uart3";
		function = "gpio";
	};
};

&uartlite {
	status = "okay";
};

&xhci {
	status = "okay";
};